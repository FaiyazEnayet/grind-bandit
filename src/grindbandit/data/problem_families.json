{
  "version": "families-v1",
  "note": "Curated solution-template families for the 218-problem bank. A tag names the canonical solution template, not the topic: BFS flood fill and BFS shortest path are different families, as are binary search on an index and binary search on the answer. A problem carries more than one tag only when two templates are both canonical for it; the note on the assignment says which. Tags are annotations for transfer measurement, human reviewed, and do not imply validated prerequisite edges.",
  "families": [
    {
      "id": "two-pointers",
      "label": "Two pointers",
      "description": "Two pointers move over a linear structure under an invariant: converging ends, fast and slow, or a read and write pointer.",
      "examples": [
        11,
        15
      ]
    },
    {
      "id": "sliding-window",
      "label": "Sliding window",
      "description": "A window over a contiguous subarray or substring expands and shrinks while a condition holds.",
      "examples": [
        3,
        219
      ]
    },
    {
      "id": "binary-search-index",
      "label": "Binary search on an index",
      "description": "Binary search over a sorted array or value range where each probe compares directly against the target.",
      "examples": [
        704,
        33
      ]
    },
    {
      "id": "binary-search-answer",
      "label": "Binary search on the answer",
      "description": "Binary search over a candidate answer using a monotonic feasibility predicate.",
      "examples": [
        875,
        69
      ]
    },
    {
      "id": "bfs-shortest-path",
      "label": "BFS shortest path",
      "description": "Breadth-first search over an unweighted graph or grid to reach a target in the fewest steps.",
      "examples": [
        994,
        1091
      ]
    },
    {
      "id": "bfs-flood-fill",
      "label": "BFS flood fill",
      "description": "Flood fill or connected-component traversal of a grid or graph, by BFS or DFS.",
      "examples": [
        200,
        130
      ]
    },
    {
      "id": "dfs-backtracking",
      "label": "Backtracking",
      "description": "Depth-first search that builds candidates incrementally and prunes dead ends.",
      "examples": [
        78,
        46
      ]
    },
    {
      "id": "dp-1d",
      "label": "One-dimensional DP",
      "description": "Dynamic programming with a linear recurrence over a prefix or running state.",
      "examples": [
        70,
        198
      ]
    },
    {
      "id": "dp-2d",
      "label": "Two-dimensional DP",
      "description": "Dynamic programming over two indices: a grid, two strings, or two sequences.",
      "examples": [
        1143,
        72
      ]
    },
    {
      "id": "dp-knapsack",
      "label": "Knapsack DP",
      "description": "Knapsack, subset-sum, or partition dynamic programming over a capacity or target sum.",
      "examples": [
        416,
        494
      ]
    },
    {
      "id": "greedy-interval",
      "label": "Greedy intervals",
      "description": "Greedy scheduling, merging, or sweep line over sorted intervals.",
      "examples": [
        56,
        435
      ]
    },
    {
      "id": "greedy-heap",
      "label": "Greedy with a heap",
      "description": "Greedy selection driven by a heap: top-k, two heaps, or smallest-sums expansion.",
      "examples": [
        215,
        347
      ]
    },
    {
      "id": "greedy-scan",
      "label": "Greedy single pass",
      "description": "One left-to-right pass tracking a running optimum or feasibility bound.",
      "examples": [
        121,
        55
      ]
    },
    {
      "id": "hashmap-counting",
      "label": "Hash map counting",
      "description": "A hash map records frequencies or complements to answer membership in constant time.",
      "examples": [
        1,
        242
      ]
    },
    {
      "id": "stack-matching",
      "label": "Stack matching",
      "description": "A stack matches, parses, or evaluates nested or postfix structure.",
      "examples": [
        20,
        150
      ]
    },
    {
      "id": "stack-monotonic",
      "label": "Monotonic stack",
